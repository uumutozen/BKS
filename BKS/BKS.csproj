<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.4.0</Version>
    <!-- Only the canonical resources below are embedded. Designer copies of
         partial forms must not generate a second BKS.Form2.resources. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>BKS.Program</StartupObject>
    <ApplicationIcon>helm_icon.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FileVersion>1.4.0.0</FileVersion>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="PaymentDetailsForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="PaymentDetailsForm.Designer.cs"><DependentUpon>PaymentDetailsForm.cs</DependentUpon></Compile>
    <EmbeddedResource Include="PaymentDetailsForm.resx"><DependentUpon>PaymentDetailsForm.cs</DependentUpon><LogicalName>BKS.PaymentDetailsForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="PaymentPlanForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="PaymentPlanForm.Designer.cs"><DependentUpon>PaymentPlanForm.cs</DependentUpon></Compile>
    <EmbeddedResource Include="PaymentPlanForm.resx"><DependentUpon>PaymentPlanForm.cs</DependentUpon><LogicalName>BKS.PaymentPlanForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="DataListForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="DataListForm.Designer.cs"><DependentUpon>DataListForm.cs</DependentUpon></Compile>
    <EmbeddedResource Include="DataListForm.resx"><DependentUpon>DataListForm.cs</DependentUpon><LogicalName>BKS.DataListForm.resources</LogicalName></EmbeddedResource>
    <Compile Update="ConnectionSettingsForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="ConnectionSettingsForm.Designer.cs"><DependentUpon>ConnectionSettingsForm.cs</DependentUpon></Compile>
    <EmbeddedResource Include="ConnectionSettingsForm.resx"><DependentUpon>ConnectionSettingsForm.cs</DependentUpon><LogicalName>BKS.ConnectionSettingsForm.resources</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Form2.cs"><SubType>Form</SubType></Compile>
    <Compile Update="Form2.Designer.cs"><DependentUpon>Form2.cs</DependentUpon></Compile>
    <Compile Update="Form2.Session.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.ModuleBehavior.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.DesignerEvents.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.User.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Commands.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Data.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Lifecycle.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Window.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.GridEvents.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Ribbon.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Actions.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="Form2.Preview.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="OgrenciForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="OgrenciForm.Designer.cs"><DependentUpon>OgrenciForm.cs</DependentUpon></Compile>
    <Compile Update="OgrenciForm.Runtime.cs"><DependentUpon>OgrenciForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="OgrenciForm.Persistence.cs"><DependentUpon>OgrenciForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="OgrenciForm.Photo.cs"><DependentUpon>OgrenciForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="PersonelForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="PersonelForm.Designer.cs"><DependentUpon>PersonelForm.cs</DependentUpon></Compile>
    <Compile Update="PersonelForm.Runtime.cs"><DependentUpon>PersonelForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="PersonelForm.Photo.cs"><DependentUpon>PersonelForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="PersonelForm.Validation.cs"><DependentUpon>PersonelForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="PersonelForm.Persistence.cs"><DependentUpon>PersonelForm.cs</DependentUpon><SubType>Code</SubType></Compile>
    <Compile Update="FormFatura.cs"><SubType>Form</SubType></Compile>
    <Compile Update="FormFatura.Designer.cs"><DependentUpon>FormFatura.cs</DependentUpon></Compile>
    <Compile Update="arsivForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="arsivForm.Designer.cs"><DependentUpon>arsivForm.cs</DependentUpon></Compile>
    <Compile Update="OzelRapor.cs"><SubType>Form</SubType></Compile>
    <Compile Update="OzelRapor.Designer.cs"><DependentUpon>OzelRapor.cs</DependentUpon></Compile>
    <Compile Update="RaporCalistirForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="RaporCalistirForm.Designer.cs"><DependentUpon>RaporCalistirForm.cs</DependentUpon></Compile>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Remove="app1.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="helm_icon.ico" />
  </ItemGroup>


  <ItemGroup>
  </ItemGroup>



  <ItemGroup>
    <EmbeddedResource Include="Form1.resx">
      <ManifestResourceName>BKS.Form1</ManifestResourceName>
      <LogicalName>BKS.Form1.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Form2.resx">
      <ManifestResourceName>BKS.Form2</ManifestResourceName>
      <LogicalName>BKS.Form2.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FormFatura.resx">
      <ManifestResourceName>BKS.FormFatura</ManifestResourceName>
      <LogicalName>BKS.FormFatura.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="OgrenciForm.resx">
      <ManifestResourceName>BKS.OgrenciForm</ManifestResourceName>
      <LogicalName>BKS.OgrenciForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PersonelForm.resx">
      <ManifestResourceName>BKS.PersonelForm</ManifestResourceName>
      <LogicalName>BKS.PersonelForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="OzelRapor.resx">
      <ManifestResourceName>BKS.OzelRapor</ManifestResourceName>
      <LogicalName>BKS.OzelRapor.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="RaporCalistirForm.resx">
      <ManifestResourceName>BKS.RaporCalistirForm</ManifestResourceName>
      <LogicalName>BKS.RaporCalistirForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="arsivForm.resx">
      <ManifestResourceName>BKS.arsivForm</ManifestResourceName>
      <LogicalName>BKS.arsivForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties/Resources.resx">
      <ManifestResourceName>BKS.Properties.Resources</ManifestResourceName>
      <LogicalName>BKS.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <Compile Update="Form2.Ribbon.cs"><SubType>Code</SubType></Compile>
    <Compile Update="Form2.NavigationChecks.cs"><DependentUpon>Form2.cs</DependentUpon><SubType>Code</SubType></Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="OzelRapor.cs">
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Update="OzelRapor.resx">
      <SubType>Designer</SubType>
      <DependentUpon>OzelRapor.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(BksOfflineDependencies)' == ''">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(BksOfflineDependencies)' != ''">
    <Reference Include="$(BksOfflineDependencies)/*.dll" Exclude="$(BksOfflineDependencies)/sni.dll" />
    <Content Include="$(BksOfflineDependencies)/sni.dll" Condition="Exists('$(BksOfflineDependencies)/sni.dll')" Link="sni.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>