<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.0</Version>
    <!-- Only the canonical resources below are embedded. Designer copies of
         partial forms must not generate a second BKS.Form2.resources. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>BKS.Program</StartupObject>
    <ApplicationIcon>helm_icon.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Remove="app1.manifest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="helm_icon.ico" />
  </ItemGroup>


  <ItemGroup>
  </ItemGroup>



  <ItemGroup>
    <EmbeddedResource Include="Form1.resx">
      <ManifestResourceName>BKS.Form1</ManifestResourceName>
      <LogicalName>BKS.Form1.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Form2.resx">
      <ManifestResourceName>BKS.Form2</ManifestResourceName>
      <LogicalName>BKS.Form2.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="FormFatura.resx">
      <ManifestResourceName>BKS.FormFatura</ManifestResourceName>
      <LogicalName>BKS.FormFatura.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="OgrenciForm.resx">
      <ManifestResourceName>BKS.OgrenciForm</ManifestResourceName>
      <LogicalName>BKS.OgrenciForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="PersonelForm.resx">
      <ManifestResourceName>BKS.PersonelForm</ManifestResourceName>
      <LogicalName>BKS.PersonelForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="OzelRapor.resx">
      <ManifestResourceName>BKS.OzelRapor</ManifestResourceName>
      <LogicalName>BKS.OzelRapor.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="RaporCalistirForm.resx">
      <ManifestResourceName>BKS.RaporCalistirForm</ManifestResourceName>
      <LogicalName>BKS.RaporCalistirForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="arsivForm.resx">
      <ManifestResourceName>BKS.arsivForm</ManifestResourceName>
      <LogicalName>BKS.arsivForm.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties/Resources.resx">
      <ManifestResourceName>BKS.Properties.Resources</ManifestResourceName>
      <LogicalName>BKS.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <Compile Update="Form2.Ribbon.cs"><SubType>Code</SubType></Compile>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="OzelRapor.cs">
      <SubType>Form</SubType>
    </Compile>
    <EmbeddedResource Update="OzelRapor.resx">
      <SubType>Designer</SubType>
      <DependentUpon>OzelRapor.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(BksOfflineDependencies)' == ''">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(BksOfflineDependencies)' != ''">
    <Reference Include="$(BksOfflineDependencies)/*.dll" Exclude="$(BksOfflineDependencies)/sni.dll" />
    <Content Include="$(BksOfflineDependencies)/sni.dll" Condition="Exists('$(BksOfflineDependencies)/sni.dll')" Link="sni.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>